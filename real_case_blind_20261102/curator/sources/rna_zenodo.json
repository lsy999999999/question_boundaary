{"created": "2026-08-17T12:52:53.976376+00:00", "modified": "2026-08-17T12:52:54.289879+00:00", "id": 21979218, "conceptrecid": "21979217", "doi": "10.5281/zenodo.21979218", "conceptdoi": "10.5281/zenodo.21979217", "doi_url": "https://doi.org/10.5281/zenodo.21979218", "metadata": {"title": "Genetic encoding and mutagenesis of RNA droplet phenotypes", "doi": "10.5281/zenodo.21979218", "publication_date": "2026-08-17", "description": "<p>This repository contains the theoretical and numerical code accompanying the manuscript <em>Genetic encoding and mutagenesis of RNA droplet phenotypes</em>.</p>\n<p>The code provides tools to construct phase diagrams for mixtures of wild-type and mutant RNA nanostars using a ternary Flory&ndash;Huggins model, with interaction parameters determined from experimental coexistence data. It also includes analysis of experimentally measured transcription rates and a reaction&ndash;diffusion model describing the evolution of RNA nanostar droplets.</p>\n<p>The repository contains the scripts and data required to reproduce the theoretical results presented in the manuscript, including the phase diagram and the predicted onset of vacuole formation as a function of mutant fraction.</p>\n<p>The associated manuscript is available <a title=\"Genetic encoding and mutagenesis of RNA droplet phenotypes\" href=\"https://chemrxiv.org/doi/full/10.26434/chemrxiv-2025-5ffnn-v2\">here</a>.</p>", "access_right": "open", "creators": [{"name": "Jaiswal, Pranay", "affiliation": null, "orcid": "0009-0003-4794-7648"}, {"name": "Haugerud, Ivar Svalheim", "affiliation": null, "orcid": "0000-0001-9931-3741"}, {"name": "Weber, Christoph A.", "affiliation": "University of Augsburg", "orcid": "0000-0001-6279-0405"}], "contributors": [{"name": "Verstraeten, William", "affiliation": "Heidelberg University", "type": "ProjectMember", "orcid": "0009-0005-4458-9579"}, {"name": "Taskina, Alena", "affiliation": "Heidelberg University", "type": "ProjectMember", "orcid": "0009-0009-2184-6607"}, {"name": "G\u00f6pfrich, Kerstin", "affiliation": "Heidelberg University", "type": "Supervisor", "orcid": "0000-0003-2115-3551"}], "version": "1.0.0", "language": "eng", "custom": {"code:codeRepository": "https://github.com/Jpranay1/RNA-Nanostar-Droplet", "code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}]}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "mesoscopic-physics-of-life"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "21979217"}}]}}, "title": "Genetic encoding and mutagenesis of RNA droplet phenotypes", "links": {"self": "https://zenodo.org/api/records/21979218", "self_html": "https://zenodo.org/records/21979218", "preview_html": "https://zenodo.org/records/21979218?preview=1", "doi": "https://doi.org/10.5281/zenodo.21979218", "self_doi": "https://doi.org/10.5281/zenodo.21979218", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21979218", "reserve_doi": "https://zenodo.org/api/records/21979218/draft/pids/doi", "parent": "https://zenodo.org/api/records/21979217", "parent_html": "https://zenodo.org/records/21979217", "parent_doi": "https://doi.org/10.5281/zenodo.21979217", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21979217", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:21979218/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:21979218/sequence/default", "files": "https://zenodo.org/api/records/21979218/files", "media_files": "https://zenodo.org/api/records/21979218/media-files", "latest": "https://zenodo.org/api/records/21979218/versions/latest", "latest_html": "https://zenodo.org/records/21979218/latest", "versions": "https://zenodo.org/api/records/21979218/versions", "draft": "https://zenodo.org/api/records/21979218/draft", "access_links": "https://zenodo.org/api/records/21979218/access/links", "access_grants": "https://zenodo.org/api/re