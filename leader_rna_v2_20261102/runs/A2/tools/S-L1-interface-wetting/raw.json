":"0000-0003-4793-9923"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute for Molecules and Materials, Radboud University, Heyendaalseweg 135, 6525 AJ Nijmegen, The Netherlands."}]}},{"fullName":"Ebbinghaus S","lastName":"Ebbinghaus","firstName":"Simon","initials":"S","authorId":{"type":"ORCID","value":"0000-0001-9309-1279"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Lehrstuhl für Biophysikalische Chemie and Research Center Chemical Sciences and Sustainability, Research Alliance Ruhr, Ruhr-Universität Bochum, 44780 Bochum, Germany."}]}},{"fullName":"De Luca G","lastName":"De Luca","firstName":"Giuseppe","initials":"G","authorId":{"type":"ORCID","value":"0000-0001-5419-6094"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Dipartimento di Scienze e Tecnologie Biologiche, Chimiche e Farmaceutiche, Università degli Studi di Palermo, Viale delle Scienze, 90128 Palermo, Italy."}]}},{"fullName":"Morando MA","lastName":"Morando","firstName":"Maria Agnese","initials":"MA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Structural Biology and Biophysics Unit, Fondazione Ri.MED, 90100 Palermo, Italy."}]}},{"fullName":"Vetri V","lastName":"Vetri","firstName":"Valeria","initials":"V","authorId":{"type":"ORCID","value":"0000-0002-2307-1165"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Dipartimento di Fisica e Chimica - Emilio Segrè, Università degli Studi di Palermo, Viale delle Scienze, 90128 Palermo, Italy."}]}},{"fullName":"Temussi PA","lastName":"Temussi","firstName":"Piero Andrea","initials":"PA","authorId":{"type":"ORCID","value":"0000-0001-6032-4291"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Università Federico II, Via Cynthia, 80100 Napoli, Italy."}]}},{"fullName":"Pastore A","lastName":"Pastore","firstName":"Annalisa","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-3047-654X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"King's College London, Denmark Hill Campus, SE5 9RT London, United Kingdom."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5419-6094"},{"type":"ORCID","value":"0000-0001-6032-4291"},{"type":"ORCID","value":"0000-0001-9309-1279"},{"type":"ORCID","value":"0000-0002-2307-1165"},{"type":"ORCID","value":"0000-0002-3047-654X"},{"type":"ORCID","value":"0000-0002-6520-0041"},{"type":"ORCID","value":"0000-0003-0374-5852"},{"type":"ORCID","value":"0000-0003-4793-9923"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"6","volume":"124","journalIssueId":3745718,"dateOfPublication":"2024 Mar","monthOfPublication":3,"yearOfPublication":2024,"journal":{"medlineAbbreviation":"Chem Rev","title":"Chemical reviews","essn":"1520-6890","issn":"0009-2665","isoabbreviation":"Chem Rev","nlmid":"2985134R"},"printPublicationDate":"2024-03-01"},"pubYear":"2024","pageInfo":"3186-3219","abstractText":"It is now generally accepted that macromolecules do not act in isolation but \"live\" in a crowded environment, that is, an environment populated by numerous different molecules. The field of molecular crowding has its origins in the far 80s but became accepted only by the end of the 90s. In the present issue, we discuss various aspects that are influenced by crowding and need to consider its effects. This Review is meant as an introduction to the theme and an analysis of the evolution of the crowding concept through time from colloidal and polymer physics to a more biological perspective. We introduce themes that will be more thoroughly treated in other Reviews of the present issue. In our intentions, each Review may stand by itself, but the complete collection has the aspiration to provide different but complementary perspectives to propose a more holistic view of molecular crowding.","affiliation":"Structural Biology and Biophysics Unit, Fondazione Ri.MED, 90100 Palermo, Italy.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"agency":"European Research Council","acronym":"ERC_","grantId":"101040138","orderIn":0},{"agency":"Federation of European Biochemical Societies","orderIn":0},{"agency":"Deutsche Forschungsgemeinschaft","grantId":"HU 807/20-1","orderIn":0},{"agency":"European Research Council","acronym":"ERC_","grantId":"851963","orderIn":0},{"agency":"Dutch Research Council (NWO)","orderIn":0},{"agency":"Human Frontier Science Program","grantId":"RGY00062/2022","orderIn":0},{"agency":"European Synchrotron Radiation Facility","orderIn":0}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1021/acs.chemrev.3c00615"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC10979406"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC10979406?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":151,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["pdb","doi"]},"dateOfCreation":"2024-03-11","dateOfRevision":"2026-09-22","electronicPublicationDate":"2024-03-11","firstPublicationDate":"2024-03-11","firstIndexDate":"2024-03-11","fullTextReceivedDate":"2025-02-04","hasEvaluations":"N"},{"id":"34245338","source":"MED","pmid":"34245338","pmcid":"PMC8272448","fullTextIdList":{"fullTextId":["PMC8272448"]},"doi":"10.1007/s00249-021-01558-w","title":"13<sup>th</sup> 